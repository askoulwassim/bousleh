{
  "title": "Bousleh Home",
  "icon": "compass",
  "description": "Every scope at every altitude, what needs you, and what Horizon found: live from the bousleh server in the Claude desktop app (where commitments in focus can be closed, dated or snoozed in place, and captures go straight to the inbox), the last snapshot elsewhere. Installable as a desktop app.",
  "file": "packages/home/dist/home.html",
  "capabilities": {
    "mcp": {
      "servers": [
        {
          "server": "host:bousleh",
          "tools": [
            "context_strata",
            "pulse_today",
            "watch_digest",
            "watchlists_get",
            "queue_list",
            "commitments_list",
            "assets_list",
            "vault_supersede",
            "commitments_close",
            "commitments_snooze",
            "inbox_drop"
          ]
        },
        {
          "server": "Google Calendar",
          "tools": ["list_events"]
        }
      ]
    },
    "db": {
      "rules": [
        {
          "path": "",
          "read": "owner",
          "write": "owner"
        }
      ]
    },
    "user": {},
    "desktop": {}
  }
}

{
  "title": "Bousleh Home",
  "icon": "compass",
  "description": "Every scope at every altitude, what needs you, and what Horizon found: live from the bousleh server in the Claude desktop app, the last snapshot elsewhere. Acts in place (commitments, findings, captures to the inbox), answers read-only questions in Ask, opens Claude with a prompt typed in, and runs Tune and health checks on this Mac. Installable as a desktop app.",
  "file": "packages/home/dist/home.html",
  "capabilities": {
    "mcp": {
      "servers": [
        {
          "server": "host:bousleh",
          "tools": [
            "context_strata",
            "pulse_today",
            "watch_digest",
            "watchlists_get",
            "queue_list",
            "commitments_list",
            "assets_list",
            "context_brief",
            "vault_search",
            "people_get",
            "vault_health",
            "vault_supersede",
            "commitments_close",
            "commitments_snooze",
            "inbox_drop",
            "inbox_settle"
          ]
        },
        { "server": "Google Calendar", "tools": ["list_events"] }
      ]
    },
    "db": {
      "rules": [{ "path": "", "read": "owner", "write": "owner" }]
    },
    "user": {},
    "desktop": {},
    "sample": {},
    "dictation": {},
    "tts": {}
  }
}

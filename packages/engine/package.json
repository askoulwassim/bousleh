{
  "name": "@bousleh/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Opens ~/.bousleh, registers every package's handlers and runs runOp(name, input, ctx) with schema checks. Owns no ops.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@bousleh/context": "workspace:*",
    "@bousleh/contracts": "workspace:*",
    "@bousleh/intake": "workspace:*",
    "@bousleh/metrics": "workspace:*",
    "@bousleh/vault": "workspace:*",
    "@bousleh/watch": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^12"
  }
}

{
  "name": "@bousleh/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Composes every module's op handlers and exports runOp(name, input, ctx), the single entry point every door calls.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@bousleh/contracts": "workspace:*",
    "@bousleh/vault": "workspace:*",
    "@bousleh/capture": "workspace:*",
    "@bousleh/context": "workspace:*",
    "@bousleh/metrics": "workspace:*",
    "@bousleh/horizon": "workspace:*",
    "zod": "^4.6.7"
  }
}

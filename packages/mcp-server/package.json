{
  "name": "@bousleh/mcp-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "One MCP tool per op, generated from the ops registry over stdio; no logic of its own.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@bousleh/contracts": "workspace:*",
    "@bousleh/engine": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "bin": {
    "bousleh-mcp": "./dist/bin.js"
  }
}

{
  "name": "@bousleh/vault",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Storage, migrations, history and typed objects in ~/.bousleh. Owns vault.*, deposits.*, commitments.*, people.*.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@bousleh/contracts": "workspace:*",
    "zod": "^4.6.7"
  }
}
